# Copy to .env (cp .env.example .env) then run ./setup.sh
# .env is git-ignored: never commit your real keys.

# --- General ---
TZ=Europe/Paris
PUID=1000
PGID=1000

# Media root, mounted as /media in EVERY container (qBittorrent, Radarr, Sonarr, Bazarr, Jellyfin).
# Keep downloads and library on the same filesystem under this root so hardlinks / in-place injection work.
# e.g. /mnt/media/video  ->  /media/downloads, /media/films, /media/series
MEDIA_ROOT=/mnt/media/video

# --- VPN (AirVPN WireGuard, from the AirVPN config generator) ---
WG_PRV_KEY=
WG_PRSHRD_KEY=
WG_ADDRESSES=10.x.x.x/32
VPN_FORWARDED_PORT=

# --- cross-seed (optional) ---
CROSS_SEED_CONFIG=/opt/cross-seed/config
